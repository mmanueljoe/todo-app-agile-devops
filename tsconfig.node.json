{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "types": ["node", "vitest/globals"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",

    /* Base URL & path aliases (for tooling that reads this config) */
    "baseUrl": "./src",
    "paths": {
      "@component/*": ["component/*"],
      "@hooks/*": ["hooks/*"],
      "@types/*": ["types/*"],
      "@test/*": ["__test__/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
